[user]
	name = jedimasterjonny
	email = 46541898+jedimasterjonny@users.noreply.github.com
[init]
	defaultBranch = main
	defaultRefFormat = files
[pull]
	rebase = true
[rerere]
	enabled = true

# Machine-local overrides — work identities, per-org settings. Untracked and
# absent from this repo. Git skips a missing include silently, so a fresh
# machine needs no extra setup.
[include]
	path = ~/.gitconfig-local
