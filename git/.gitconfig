[user]
	name = jedimasterjonny
	email = 46541898+jedimasterjonny@users.noreply.github.com
[init]
	defaultBranch = main
	defaultRefFormat = files
[pull]
	rebase = true
[push]
	# Pair for pull.rebase above: new branches push without --set-upstream.
	autoSetupRemote = true
[diff]
	algorithm = histogram
[merge]
	# zdiff3 keeps the common ancestor in a conflict, like diff3, but hoists the
	# lines both sides agree on out of the marked region.
	conflictstyle = zdiff3
[rerere]
	enabled = true

# Machine-local overrides — work identities, per-org settings. Untracked and
# absent from this repo. Git skips a missing include silently, so a fresh
# machine needs no extra setup.
[include]
	path = ~/.gitconfig-local
