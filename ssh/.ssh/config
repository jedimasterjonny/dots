# Machine-local hosts first — work jump boxes, per-host keys, anything whose
# name would leak in a public repo. Untracked and absent from this repo; ssh
# ignores a missing include silently, so a fresh machine needs no extra setup.
#
# Its position is load-bearing, and is the opposite of what ~/.gitconfig does
# with the same trick. Git takes the last value it reads; ssh takes the first,
# and never revisits a keyword once something has set it. So this has to come
# before the Host * block below, or the defaults there would be the first
# match for every keyword and the local file could never override any of them.
Include ~/.ssh/config.local

Host *
	# Load a key into the agent the first time it is used, rather than only
	# ever when ssh-add is run by hand — one passphrase prompt per login
	# instead of one per connection.
	AddKeysToAgent yes

	# Without these a connection that dies quietly — a NAT table dropping an
	# idle mapping, a laptop changing network — leaves a session that looks
	# alive and hangs forever on the next keystroke. Three missed probes at
	# 60s ends it instead.
	ServerAliveInterval 60
	ServerAliveCountMax 3

	# Reuse one authenticated connection for every later session to the same
	# host, so they skip the TCP handshake, key exchange and auth entirely.
	# Most visible where a command opens its own connection each time it runs:
	# a fetch-then-push cycle over ssh pays that setup twice otherwise.
	ControlMaster auto
	ControlPersist 10m
	# Under /run/user rather than ~/.ssh for two reasons. A control socket is
	# runtime state that must not outlive the boot, and this is a tmpfs that
	# logind creates per user and clears on logout — nothing to create here,
	# and no stale sockets to reap. And a unix socket path cannot exceed ~104
	# characters: %C hashes the host, port and user into a fixed-width digest,
	# so no long hostname can push it over.
	ControlPath /run/user/%i/ssh-%C
